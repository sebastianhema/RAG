AWS_REGION=us-east-1
KNOWLEDGE_BASE_ID=your-knowledge-base-id
MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-3-5-sonnet-20240620-v1:0

# Optional local AWS auth. Leave blank to use default credential chain.
# If you set AWS_PROFILE, set it to a real profile name (empty values break boto3).
# AWS_PROFILE=default
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# API configuration
# Comma-separated Bearer tokens for /api/rag/query (generate e.g. openssl rand -hex 32)
API_KEYS=your-first-key,your-second-key-optional
CORS_ORIGINS=*
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
